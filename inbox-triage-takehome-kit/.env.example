# ---- shared by the provider (replay script) and your service ----
WEBHOOK_SECRET=whsec_test_do_not_use_in_prod

# ---- your service ----
PORT=3000
DOWNSTREAM_URL=http://localhost:4000
LLM_PROVIDER=mock            # mock | anthropic | openai | gemini | ... (your choice)
LLM_API_KEY=                 # never commit a real key
LLM_MODEL=                   # e.g. claude-sonnet-4-6 / gpt-4o-mini / ...
LLM_TIMEOUT_MS=20000

# ---- mock ticketing API (npm run downstream) ----
DOWNSTREAM_PORT=4000
FAIL_RATE=0.3                # fraction of new POSTs answered with 500/503
TIMEOUT_RATE=0.1             # fraction of new POSTs that create the ticket and then hang
HANG_MS=15000
RATE_LIMIT_EVERY=7           # every Nth POST gets 429 + Retry-After (0 disables)
# SEED=42                    # deterministic failure injection

# ---- replay script (npm run replay) ----
WEBHOOK_URL=http://localhost:3000/webhooks/inbox
SETTLE_SECONDS=45
